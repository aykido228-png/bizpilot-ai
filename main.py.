
import os
import time
import requests

TOKEN = os.environ["TELEGRAM_BOT_TOKEN"]
API = f"https://api.telegram.org/bot{TOKEN}"

offset = 0

def send_message(chat_id, text):
    requests.post(
        f"{API}/sendMessage",
        json={"chat_id": chat_id, "text": text},
        timeout=20
    )

def handle_message(message):
    chat_id = message["chat"]["id"]
    text = message.get("text", "").strip()

    if text == "/start":
        send_message(
            chat_id,
            "Welcome to BizPilot AI!\n\n"
            "Добро пожаловать в BizPilot AI!\n\n"
            "Your AI business assistant is being built."
        )
    elif text == "/help":
        send_message(
            chat_id,
            "BizPilot AI — your future business assistant.\n"
            "Напиши /start для начала."
        )
    else:
        send_message(
            chat_id,
            "Спасибо! BizPilot AI скоро сможет "
            "обрабатывать такие запросы с помощью AI."
        )

print("BizPilot AI is starting...")

while True:
    try:
        response = requests.get(
            f"{API}/getUpdates",
            params={"offset": offset, "timeout": 30},
            timeout=35
        ).json()

        if response.get("ok"):
            for update in response["result"]:
                offset = update["update_id"] + 1
                message = update.get("message")

                if message:
                    handle_message(message)

    except Exception as error:
        print("Error:", error)
        time.sleep(5)
      
